# --------------------------------
# Prepare Data for Plotting
# --------------------------------
cogdx_simplified = all_results[, c(
  "hg18DE_cogdx_simplified", 
  "hg19DE_cogdx_simplified", 
  "v30DE_cogdx_simplified", 
  "v43DE_cogdx_simplified", 
  "T2TDE_cogdx_simplified"
)]

data_long <- gather(
  cogdx_simplified,
  key   = "Category",
  value = "Count",
  na.rm = TRUE        # ← drop any rows where Count is NA
)

# -----------------------
# Build the Plot
# -----------------------
a = ggplot(
  data = data_long, 
  mapping = aes(x = Category, fill = Count)
) +
  geom_bar(
    stat     = "count",     # count number of entries per category/status
    position = "stack"      # stack bars by Count groups
  ) +
  xlab("Reference") +
  ylab("Genes Expressed") +
  theme_minimal(base_size = 16) +  # minimalist theme with base font size
  theme(
    axis.text.x  = element_text(size = 20, hjust = 1, angle = 90),
    axis.text.y  = element_text(size = 20),
    axis.title.x = element_text(size = 22),
    axis.title.y = element_text(size = 22),
    legend.text  = element_text(size = 17),
    legend.title = element_text(size = 18),
    plot.title   = element_text(size = 20, face = "bold", hjust = 0.5)
  ) +
  scale_fill_manual(
    values = c("grey", "darkgreen"),  # colors for FDR >0.05 and <=0.05
    labels = expression("" > 0.05, "" <= 0.05)
  ) +
  labs(fill = 'FDR') +
  # Add count labels above each bar
  geom_text(
    stat    = 'count',  # same stat as geom_bar
    aes(label = ..count..), 
    color   = "black", 
    vjust   = -0.5,      # nudge text above bar
    size    = 5          # text size
  ) +
  # Relabel x-axis ticks for clarity
  scale_x_discrete(
    labels = c(
      "NCBI36", 
      "GRCh37", 
      "GRCh38.p12", 
      "GRCh38.p13", 
      "CHM13v2.0"
    )
  )

# --------------------------------
# Save Plot to Files
# --------------------------------

ggsave(a, filename    = paste0("overview_DE_cogdx_simplified.pdf"),useDingbats = FALSE)
