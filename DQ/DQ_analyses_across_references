# Utility functions
MyBatchtoolsLSFParam <- function(..., registryargs = batchtoolsRegistryargs()) {
  registryargs$conf.file <- path_conf_file
  bt_conf <- within(list(), { source(path_conf_file, local = TRUE) })
  param <- BatchtoolsParam(cluster = "lsf", registryargs = registryargs, ...)
  if (!is.null(bt_conf$default.resources)) {
    merged_resources <- bt_conf$default.resources
    merged_resources[names(param$resources)] <- param$resources
    param$resources <- merged_resources
  }
  bpstart(param)
  if (!is.null(bt_conf$cluster.functions)) {
    param$registry$cluster.functions <- bt_conf$cluster.functions
  }
  param
}

# Strip version suffix from gene IDs
strip_version <- function(ids) {
  vapply(ids, function(id) {
    parts <- strsplit(id, '.', fixed = TRUE)[[1]]
    if (length(parts) == 1) return(parts[1])
    suffix <- parts[2]
    subparts <- strsplit(suffix, '_', fixed = TRUE)[[1]]
    if (length(subparts) < 3) return(parts[1])
    paste(parts[1], paste(subparts[2:3], collapse = '_'), sep = '_')
  }, character(1))
}

# Append decimal counters to duplicated IDs
add_decimal_numbers <- function(target_values, value_list) {
  idx <- match(value_list, target_values)
  ifelse(!is.na(idx),
         paste0(value_list, '.', ave(seq_along(value_list), idx, FUN = seq_along)),
         value_list)
}

# Peek into objects
peek <- function(x, n = 6) {
  if (is.null(dim(x)) && !is.null(length(x))) {
    head(x, n)
  } else if (length(dim(x)) == 2) {
    x[1:min(n, nrow(x)), 1:min(n, ncol(x)), drop = FALSE]
  } else {
    stop("Unsupported object class ", class(x)[1])
  }
}

# Duplicate rows based on count_dataset
duplicate_rows_based_on_count <- function(dataset, coldup, count_dataset) {
  overlap <- intersect(dataset[[coldup]], count_dataset[[coldup]])
  counts  <- table(count_dataset[[coldup]][count_dataset[[coldup]] %in% overlap])
  single  <- dataset[dataset[[coldup]] %in% names(counts[counts == 1]), ]
  non     <- dataset[!dataset[[coldup]] %in% names(counts), ]
  multi   <- dataset[dataset[[coldup]] %in% names(counts[counts > 1]), ]
  dup_list <- lapply(names(counts[counts > 1]]), function(val) {
    df0 <- multi[multi[[coldup]] == val, ]
    occ <- counts[val]
    df_rep <- df0[rep(seq_len(nrow(df0)), each = occ), ]
    df_rep[[coldup]] <- paste0(val, '.', rep(seq_len(occ), times = nrow(df0)))
    rownames(df_rep) <- df_rep[[coldup]]
    df_rep
  })
  do.call(rbind, c(list(single), dup_list, list(non)))
}

# Load expression matrix for a given genome build
load_expression_data <- function(genome, date_txt = date_default) {
  subdir <- paste0("Rosmap", genome)
  fname  <- paste0("allcount_matrix_", date_txt, ".txt")
  data_file <- file.path(path_prefix, subdir, "expression", fname)
  dt <- fread(data_file, data.table = FALSE)
  rownames(dt) <- dt$Geneid
  dt$Geneid <- NULL
  dt
}

