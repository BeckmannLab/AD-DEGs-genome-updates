## Define functions: batchtools, suffix, peek, duplication ##
MyBatchtoolsLSFParam <- function(..., registryargs = batchtoolsRegistryargs(),
                                  conf.file = path_to_conf_file) {
    if (missing(conf.file)) return(BatchtoolsParam(..., registryargs = registryargs))
    registryargs$conf.file <- conf.file
    bt_conf <- within(list(), source(conf.file, local = TRUE))
    param <- BatchtoolsParam(cluster = "lsf", registryargs = registryargs, ...)
    if (!is.null(bt_conf$default.resources)) {
        merged <- bt_conf$default.resources
        merged[names(param$resources)] <- param$resources
        param$resources <- merged
    }
    bpstart(param)
    if (!is.null(bt_conf$cluster.functions)) {
        param$registry$cluster.functions <- bt_conf$cluster.functions
    }
    param
}
add_decimal_numbers <- function(target_values, value_list) {
    idx <- match(value_list, target_values)
    ifelse(!is.na(idx),
           paste0(value_list, ".", ave(seq_along(value_list), idx, FUN = seq_along)),
           value_list)
}
peek <- function(x, n = 6) {
    if (is.null(dim(x))) head(x, n = n)
    else x[1:min(n, nrow(x)), 1:min(n, ncol(x)), drop = FALSE]
}
duplicate_rows_based_on_count <- function(dataset, column_to_duplicate, count_dataset) {
    overlap <- intersect(dataset[[column_to_duplicate]], count_dataset[[column_to_duplicate]])
    counts <- table(count_dataset[[column_to_duplicate]][count_dataset[[column_to_duplicate]] %in% overlap])
    not_in <- setdiff(dataset[[column_to_duplicate]], names(counts))
    one_occ <- dataset[dataset[[column_to_duplicate]] %in% names(counts[counts == 1]), ]
    non_count <- dataset[dataset[[column_to_duplicate]] %in% not_in, ]
    multi <- dataset[dataset[[column_to_duplicate]] %in% names(counts[counts > 1]), ]
    assert_that(sum(is.na(multi)) == 0)
    for (i in seq_len(nrow(multi))) {
        val <- multi[i, column_to_duplicate]; nrep <- counts[val]
        dup <- multi[rep(i, nrep), ]
        dup[[column_to_duplicate]] <- paste0(val, ".", seq_len(nrep))
        rownames(dup) <- dup[[column_to_duplicate]]
        if (i == 1) dataset_dup <- dup else dataset_dup <- rbind(dataset_dup, dup)
    }
    rbind(one_occ, dataset_dup, non_count)
}

