# Function to process each iteration
process_iteration <- function(row) {
  old_var      <- row[[1]]
  old_ver      <- row[[2]]
  new_assign   <- row[[3]]
  new_var      <- row[[4]]
  new_ver      <- row[[5]]
  new_assign2  <- row[[6]]
  merged_name  <- row[[7]]
  combo_subdir <- row[[8]]
  covar_name   <- row[[9]]

  # expression RDS filepath
  combo_dir <- file.path(path_combos, combo_subdir)
  expr_file <- file.path(combo_dir, "expression", sprintf("allcount_matrix_%s_%s.RDS", combo_subdir, date_default))

  if (!file.exists(expr_file)) {
    # New build
    dat_new <- get(new_var)
    df_new  <- dat_new[, intersect(colnames(dat_new), make.names(ids_to_keep)), drop = FALSE]
    colnames(df_new) <- paste0(colnames(df_new), ".", new_ver)
    df_new <- as.data.table(df_new, keep.rownames = TRUE)
    assign(new_assign2, df_new, envir = .GlobalEnv)

    # Old build
    dat_old <- get(old_var)
    rownames(dat_old) <- strip_version(rownames(dat_old))
    df_old <- dat_old[, intersect(colnames(dat_old), make.names(ids_to_keep)), drop = FALSE]
    colnames(df_old) <- paste0(colnames(df_old), ".", old_ver)
    df_old <- as.data.table(df_old, keep.rownames = TRUE)
    assign(new_assign, df_old, envir = .GlobalEnv)

    # Merge and save
    merged <- merge(get(new_assign), get(new_assign2), by = "rn", all = TRUE)
    merged[is.na(merged)] <- 0
    rownames(merged) <- merged$rn
    merged$rn <- NULL
    assign(merged_name, merged, envir = .GlobalEnv)
    saveRDS(merged, file.path(combo_dir, "expression", sprintf("allcount_matrix_%s_%s.RDS", combo_subdir, date_default)))
  } else {
    merged <- readRDS(expr_file)
    assign(merged_name, merged, envir = .GlobalEnv)
  }

  # Build covariate table
  info1 <- info_all_base
  info2 <- info_all_base
  info1$sample   <- paste0(info1$sample, ".", old_ver)
  info2$sample   <- paste0(info2$sample, ".", new_ver)
  info1$assembly <- old_ver
  info2$assembly <- new_ver
  covar <- rbind(info1, info2)
  assign(covar_name, covar, envir = .GlobalEnv)
  saveRDS(covar, file.path(combo_dir, "covariate", sprintf("info_all_%s_%s.RDS", combo_subdir, date_default)))

  # Differential expression with voom + dream
  expr_mat <- get(merged_name)
  isexpr <- rowSums(cpm(expr_mat) >= 1) >= 0.1 * ncol(expr_mat)
  dge     <- DGEList(counts = expr_mat[isexpr, ])
  dge     <- calcNormFactors(dge)

  covar2 <- covar
  covar2$id       <- covar2$original_sample
  rownames(covar2) <- make.names(covar2$sample)
  design <- model.matrix(~ (1 | id), covar2)
  vobj   <- voom(dge, design, plot = FALSE)

  # Contrast between new and old
  status <- "assembly"
  formula_str <- as.formula(paste0("~ 0 + ", status, " + (1|id)"))
  L <- getContrast(vobj, formula_str, covar2,
                   c(paste0("assembly", new_ver), paste0("assembly", old_ver)))

  # Fit dream
  fit_file <- file.path(combo_dir, "DE", new_ver, old_ver, "fitDream.RDS")
  if (!file.exists(fit_file)) {
    dir.create(dirname(fit_file), recursive = TRUE, showWarnings = FALSE)
    fit <- dream(vobj, formula_str, covar2, L,
                 BPPARAM = MyBatchtoolsLSFParam(workers = 100, resources = list(walltime = 30*60, threads_per_job = 1, memory = "15GB")))
    saveRDS(fit, fit_file)
  } else {
    fit <- readRDS(fit_file)
  }

  # Top table and save
  res <- topTable(fit, coef = "L1", number = Inf, sort.by = "P")
  fwrite(res, file.path(combo_dir, "DE", sprintf("DE_assembly_corrected_for_id_%s_test.txt", status)),
         sep = "\t", quote = FALSE)
}

# Run all iterations in parallel
foreach(i = seq_len(nrow(all_var)), .packages = c("data.table","limma","edgeR","variancePartition","assertthat")) %dopar% {
  process_iteration(all_var[i, ])
}
